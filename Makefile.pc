# QFS - Makefile.pc: PC: datos, pruebas y capturas (no genera el binario del QL)
#   make -f Makefile.pc datos     -> tablas, escenario de demo y aviones
#   make -f Makefile.pc prueba    -> compila y ejecuta las pruebas de fisica/navegacion/render
#   make -f Makefile.pc capturas  -> pasa las capturas de pantalla QL a PNG
# El binario y las imagenes del QL se generan con el Makefile por defecto (qcc de XTC68). Uso: make -f Makefile.pc <objetivo>

# python: el venv local (.venv, con reportlab y shapely: pip install -r requirements.txt) si existe
PY      = $(shell test -x .venv/bin/python && echo .venv/bin/python || echo python3)
CC      = gcc
CFLAGS  = -std=c89 -pedantic -Wall -Wextra -Wno-unused-parameter -DHOST -O1 -g

PANELES = data/planeador.src data/mono.src data/bimotor.src data/reactor.src   # fondo del panel de cada avion (volcado de pantalla)

COMUN   = src/fixmath.c src/tables.c src/gfx.c src/world.c src/view3d.c \
          src/aircraft.c src/flight.c src/nav.c src/atc.c src/util.c \
          src/panel.c src/sound.c src/sim.c

all: datos prueba capturas cartas

src/tables.c: tools/gentables.py
	$(PY) tools/gentables.py src/tables.c

datos: src/tables.c build/demo.scn build/iberia.scn data/mono.acf $(PANELES)

build/demo.scn: data/demo.txt tools/mkscen.py
	@mkdir -p build
	$(PY) tools/mkscen.py data/demo.txt build/demo.scn

# Peninsula Iberica: ESCALA=0.5 (por defecto) o ESCALA=1.0 (tamano real)
ESCALA ?= 0.5
build/iberia.scn: tools/iberia.py tools/mkscen.py tools/procdesign.py
	@mkdir -p build
	$(PY) tools/iberia.py $(ESCALA) build/iberia.scn data/iberia.txt
	$(PY) tools/mapa_scn.py build/iberia.scn build/iberia_mapa.png 1100

data/mono.acf: tools/mkaviones.py
	$(PY) tools/mkaviones.py data

# los .src se regeneran si cambia el avion o el codigo del panel
build/mkpanel: tools/mkpanel.c $(COMUN) src/platform_host.c src/*.h
	@mkdir -p build
	$(CC) $(CFLAGS) -Isrc $(COMUN) src/platform_host.c tools/mkpanel.c -lm -o $@

data/%.src: data/%.acf build/mkpanel
	./build/mkpanel $<

build/hosttest: $(COMUN) src/platform_host.c tests/hosttest.c src/*.h
	$(CC) $(CFLAGS) $(COMUN) src/platform_host.c tests/hosttest.c -lm -o $@

build/iberiatest: $(COMUN) src/platform_host.c tests/iberiatest.c src/*.h
	$(CC) $(CFLAGS) $(COMUN) src/platform_host.c tests/iberiatest.c -o $@

prueba: datos build/hosttest build/iberiatest
	@mkdir -p build/shots
	./build/hosttest
	./build/iberiatest

# cartas aeronauticas del escenario iberico (PDF para el manual)
cartas: build/iberia.scn tools/cartas.py tools/cartas_a5.py tools/procdesign.py
	$(PY) tools/cartas.py $(ESCALA) build/cartas

# manual de instrucciones A5 (doc/QFS_Manual_A5.pdf): pandoc + XeLaTeX, ver tools/libro.sh
libro: doc/libro/manual.md tools/libro.sh
	./tools/libro.sh

capturas:
	for f in build/shots/*.scr; do $(PY) tools/qlscr2png.py $$f $${f%.scr}.png; done

# disco para el QL: nombres QDOS (punto -> subrayado)
disco: datos
	@mkdir -p build/disco
	cp build/demo.scn build/disco/demo_scn
	cp build/iberia.scn build/disco/iberia_scn
	for f in data/*.acf; do b=$$(basename $$f .acf); cp $$f build/disco/$${b}_acf; cp data/$$b.src build/disco/$${b}_src; done

clean:
	rm -rf build/hosttest build/iberiatest build/shots build/disco

.PHONY: all datos prueba capturas cartas libro disco clean
